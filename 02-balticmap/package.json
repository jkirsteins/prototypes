{
  "name": "balticmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude tests/sim.test.ts --exclude tests/scenarios.test.ts",
    "test:all": "vitest run",
    "balance": "vitest run tests/sim.test.ts tests/scenarios.test.ts && vite-node scripts/balance.ts",
    "rarity": "vite-node scripts/rarity.ts",
    "simulate": "vite-node scripts/simulate.ts",
    "sweep": "vite-node scripts/sweep.ts",
    "simulate:check": "vite-node scripts/check-scenarios.ts",
    "simulate:world": "vite-node scripts/simulate-world.ts",
    "capture:baseline": "vite-node scripts/capture-sim-baseline.ts",
    "prepare-data": "node scripts/prepare-data.mjs",
    "prepare-iberia": "node scripts/prepare-iberia.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "d3-geo": "^3.1.1",
    "happy-dom": "^15.11.0",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
