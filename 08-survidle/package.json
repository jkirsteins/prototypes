{
  "name": "survidle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "node scripts/check-test-discovery.mjs",
    "test": "vitest run",
    "pretest:slow": "node scripts/check-test-discovery.mjs",
    "test:slow": "SURVIDLE_TEST_SUITE=slow vitest run",
    "typecheck": "tsc --noEmit",
    "reference": "vite-node scripts/reference.ts",
    "horizon": "vite-node scripts/horizon.ts",
    "year": "vite-node scripts/year.ts",
    "weather:profile": "vite-node scripts/weather-profile.ts",
    "hunt-stress": "vite-node scripts/hunt-stress.ts",
    "december": "vite-node scripts/december.ts",
    "startle-seeds": "vite-node scripts/startle-seeds.ts",
    "startle-shots": "node scripts/startle-shots.mjs",
    "shots": "node scripts/map-shots.mjs",
    "sky": "node scripts/sky-shots.mjs",
    "opportunity-ux": "node scripts/opportunity-ux.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "happy-dom": "^15.11.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.12.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0"
  }
}
